#      melee_damage: 1.5        # Overall white/melee damage multiplier
#      spell_damage: 1.4        # Default spell damage multiplier
#
#    creatures:
#      - entry: 11520           # Creature template ID
#        health: 5.0            # Optional; omit or use 0 to inherit overall
#        melee_damage: 2.0      # Optional; omit or use 0 to inherit overall
#        spells:
#          - id: 9532           # Existing or additional spell ID
#            damage: 1.8        # Optional; 0 inherits overall spell damage
#            initial_min_ms: 2000
#            initial_max_ms: 4000
#            cooldown_min_ms: 7000
#            cooldown_max_ms: 10000
#            target: victim     # victim, random_player, or self
#            replace_original: true # Block ordinary cast and use this schedule
#          - id: 11970          # Example additional ability
#            damage: 1.5
#            initial_min_ms: 5000
#            initial_max_ms: 8000
#            cooldown_min_ms: 12000
#            cooldown_max_ms: 16000
#            target: random_player
#            replace_original: false
#        loot:
#          mode: replace        # add keeps normal loot; replace uses YAML only
